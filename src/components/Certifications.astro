---
import RightIcon from "./icons/RightIcon.astro";
import LeftIcon from "./icons/LeftIcon.astro";

import Freecodecamp from "/public/Resources/Freecodecamp.avif";
import Udemy from "/public/Resources/Udemy.avif";
import Coursera from "/public/Resources/Coursera.avif";

interface Props {
  title: string;
  teacher: string;
  link: string;
  school: string;
  certificate?: string;
}

const CERTIFICATES: Props[] = [
  {
    title: "The Complete JavaScript Course 2023: From Zero to Hero",
    teacher: "Jonas Schmedtmann",
    school: "Udemy",
    link: "https://www.udemy.com/course/the-complete-javascript-course/?couponCode=ACCAGE0923",
    certificate:
      "https://www.udemy.com/certificate/UC-a1c863fa-621c-4167-9b61-7783c0f432df/",
  },
  {
    title: "JavaScript Algorithms and Data Structures",
    teacher: "FreeCodeCamp",
    school: "FreeCodeCamp",
    link: "https://www.freecodecamp.org/learn/javascript-algorithms-and-data-structures-v8/",
    certificate:
      "https://www.freecodecamp.org/certification/Draenon/javascript-algorithms-and-data-structures",
  },
  {
    title: "Build Responsive Real-World Websites with HTML and CSS",
    teacher: "Jonas Schmedtmann",
    school: "Udemy",
    link: "https://www.udemy.com/course/design-and-develop-a-killer-website-with-html5-and-css3/?couponCode=ACCAGE0923",
    certificate:
      "https://www.udemy.com/certificate/UC-c0cf1136-2375-4f04-a63f-c46490e10fc5/",
  },
  {
    title: "Responsive Web Design",
    teacher: "FreeCodeCamp",
    school: "FreeCodeCamp",
    link: "https://www.freecodecamp.org/learn/2022/responsive-web-design/",
    certificate:
      "https://www.freecodecamp.org/certification/Draenon/responsive-web-design",
  },
  {
    title: "The Complete 2024 Web Develpment Bootcamp",
    teacher: "Angela Yu",
    school: "Udemy",
    link: "https://www.udemy.com/course/the-complete-web-development-bootcamp/?couponCode=ACCAGE0923",
    certificate: "",
  },
  {
    title: "Next.js: El framework de React para producción",
    teacher: "Fernando Herrera",
    school: "Udemy",
    link: "https://www.udemy.com/course/nextjs-fh/",
    certificate: "",
  },
  {
    title: "React - The Complete Guide 2024 (incl. Next.js, Redux)",
    teacher: "Maximilian Schwarzmüller",
    school: "Udemy",
    link: "https://www.udemy.com/course/react-the-complete-guide-incl-redux/?couponCode=ACCAGE0923",
    certificate: "",
  },
  {
    title: "Advanced CSS and Sass: Flexbox, Grid, Animations and More!",
    teacher: "Jonas Schmedtmann",
    school: "Udemy",
    link: "https://www.udemy.com/course/advanced-css-and-sass/?couponCode=ACCAGE0923",
    certificate: "",
  },
  {
    title: "UX Design by Google",
    teacher: "Google",
    school: "Coursera",
    link: "https://www.coursera.org/professional-certificates/diseno-de-experiencia-del-usuario-ux-de-google",
    certificate: "",
  },
];
---

<section
  class="carousel-container relative w-full max-w-[700px] my-0 mx-auto overflow-hidden mt-10"
>
  <div
    class="carousel flex transition-transform transform duration-500 ease-in-out"
  >
    {
      CERTIFICATES.map(
        ({ title, teacher, school, link, certificate }, index) => (
          <div class="carousel-item opacity-30 transition-opacity duration-300 ease-in-out">
            <div class="card text-center ">
              <a href={link} target="_blank" rel="noopener noreferrer">
                <div class="flex flex-col items-center gap-6 card-content">
                  <h4 class="text-xl max-sm:text-md">{title}</h4>
                  <h5 class="text-sm text-gray-200">{teacher}</h5>
                  <figure class="flex items-center justify-center">
                    {school === "FreeCodeCamp" ? (
                      <img
                        src={Freecodecamp.src}
                        alt="Freecodecamp"
                        class="w-10 h-10 rounded-full"
                      />
                    ) : school === "Udemy" ? (
                      <img
                        src={Udemy.src}
                        alt="Udemy"
                        class="w-10 h-10 rounded-full"
                      />
                    ) : (
                      <img
                        src={Coursera.src}
                        alt="Coursera"
                        class="w-10 h-10 rounded-full"
                      />
                    )}
                  </figure>
                </div>
              </a>
              {certificate && (
                <a
                  href={certificate}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="certificate-button"
                >
                  Certificado
                </a>
              )}
            </div>
          </div>
        ),
      )
    }
  </div>
  <button class="carousel-control prev" aria-label="Anterior"
    ><LeftIcon /></button
  >
  <button class="carousel-control next" aria-label="Siguiente"
    ><RightIcon /></button
  >
</section>

<style>
  .carousel-item {
    flex: 0 0 100%;
  }

  .carousel-item.active {
    opacity: 1;
  }

  .certificate-button {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.5rem 1rem;
    background-color: transparent;
    color: white;
    border-radius: 4px;
    text-decoration: none;
    border-radius: 24px;
    border: 2px solid #542ca5;
  }

  .carousel-control {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    border-radius: 100%;
    background: transparent;
    border: 1px solid var(--main-color);
    color: white;
    font-size: 1.5rem;
    padding: 0.2rem;
    cursor: pointer;
  }

  .prev {
    left: 0;
  }
  .next {
    right: 0;
  }
</style>

<script>
  const carousel = document.querySelector(".carousel");
  const items = carousel.querySelectorAll(".carousel-item");
  const prevBtn = document.querySelector(".prev");
  const nextBtn = document.querySelector(".next");
  let currentIndex = 0;

  function updateCarousel() {
    items.forEach((item, index) => {
      item.classList.toggle("active", index === currentIndex);
    });
    carousel.style.transform = `translateX(-${currentIndex * 100}%)`;
  }

  function moveCarousel(direction) {
    currentIndex = (currentIndex + direction + items.length) % items.length;
    updateCarousel();
  }

  prevBtn.addEventListener("click", () => moveCarousel(-1));
  nextBtn.addEventListener("click", () => moveCarousel(1));

  updateCarousel();

  document.addEventListener("keydown", (e) => {
    if (e.key === "ArrowLeft") moveCarousel(-1);
    if (e.key === "ArrowRight") moveCarousel(1);
  });
</script>
