---
interface Props {
  title: string;
  teacher: string;
  link: string;
  school: string;
  certificate?: string;
}

const CERTIFICATES: Props[] = [
  {
    title: "The Complete JavaScript Course 2023: From Zero to Hero",
    teacher: "Jonas Schmedtmann",
    school: "Udemy",
    link: "https://www.udemy.com/course/the-complete-javascript-course/?couponCode=ACCAGE0923",
    certificate:
      "https://www.udemy.com/certificate/UC-a1c863fa-621c-4167-9b61-7783c0f432df/",
  },
  {
    title: "JavaScript Algorithms and Data Structures",
    teacher: "FreeCodeCamp",
    school: "FreeCodeCamp",
    link: "https://www.freecodecamp.org/learn/javascript-algorithms-and-data-structures-v8/",
    certificate:
      "https://www.freecodecamp.org/certification/Draenon/javascript-algorithms-and-data-structures",
  },
  {
    title: "Build Responsive Real-World Websites with HTML and CSS",
    teacher: "Jonas Schmedtmann",
    school: "Udemy",
    link: "https://www.udemy.com/course/design-and-develop-a-killer-website-with-html5-and-css3/?couponCode=ACCAGE0923",
    certificate:
      "https://www.udemy.com/certificate/UC-c0cf1136-2375-4f04-a63f-c46490e10fc5/",
  },
  {
    title: "Responsive Web Design",
    teacher: "FreeCodeCamp",
    school: "FreeCodeCamp",
    link: "https://www.freecodecamp.org/learn/2022/responsive-web-design/",
    certificate:
      "https://www.freecodecamp.org/certification/Draenon/responsive-web-design",
  },
  {
    title: "The Complete 2024 Web Develpment Bootcamp",
    teacher: "Angela Yu",
    school: "Udemy",
    link: "https://www.udemy.com/course/the-complete-web-development-bootcamp/?couponCode=ACCAGE0923",
    certificate: "",
  },
  {
    title: "Next.js: El framework de React para producción",
    teacher: "Fernando Herrera",
    school: "Udemy",
    link: "https://www.udemy.com/course/nextjs-fh/",
    certificate: "",
  },
  {
    title: "React - The Complete Guide 2024 (incl. Next.js, Redux)",
    teacher: "Maximilian Schwarzmüller",
    school: "Udemy",
    link: "https://www.udemy.com/course/react-the-complete-guide-incl-redux/?couponCode=ACCAGE0923",
    certificate: "",
  },
  {
    title: "Advanced CSS and Sass: Flexbox, Grid, Animations and More!",
    teacher: "Jonas Schmedtmann",
    school: "Udemy",
    link: "https://www.udemy.com/course/advanced-css-and-sass/?couponCode=ACCAGE0923",
    certificate: "",
  },
  {
    title: "UX Design by Google",
    teacher: "Google",
    school: "Coursera",
    link: "https://www.coursera.org/professional-certificates/diseno-de-experiencia-del-usuario-ux-de-google",
    certificate: "",
  },
];
---

<section>
  <div class="grid grid-cols-3 mx-auto gap-4">
    {
      CERTIFICATES.map(({ title, teacher, school, link, certificate }) => (
        <div class="text-center">
          <a href={link} target="_blank">
            <div class="bg-transparent px-4 py-2 flex flex-col gap-y-2">
              <h4>{title}</h4>
              <h5 class="text-sm text-gray-300">{teacher}</h5>
            </div>
          </a>
          {certificate && (
            <button href={certificate} target="_blank">
              Certificado
            </button>
          )}
        </div>
      ))
    }
  </div>
</section>
